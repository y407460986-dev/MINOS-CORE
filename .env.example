MINOS_OPENAI_MODEL=gpt-5.4
MINOS_OPENAI_BASE_URL=https://allinai7.cloud
# 不要写入仓库；运行时优先读取环境变量。
# 读取顺序：MINOS_OPENAI_API_KEY -> OPENAI_API_KEY -> ARK_API_KEY -> Codex auth.json。
# 没有环境变量时，会读取 %USERPROFILE%\.codex\config.toml 和 auth.json 的模型、中转地址、密钥。
MINOS_OPENAI_API_KEY=
MINOS_OPENAI_REASONING_EFFORT=high
# 如需禁用 Codex 配置复用，设为 1。
MINOS_DISABLE_CODEX_CONFIG=0
