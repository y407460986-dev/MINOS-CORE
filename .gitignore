# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Local environments and secrets
.env
.env.*
!.env.example
.venv/
.venv-build/
venv/
env/
ENV/

# Certificates and private keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Credential and secret files
secrets.json
credentials.json
auth.json
*.credentials

# Cloud provider configurations
.aws/
.gcp/
.azure/

# Database files (exclude test databases)
*.sqlite3
*.db
!test*.db
!*test.db

# Claude Code local-only configuration
.claude/settings.local.json
.claude/*.local.json

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
node_modules/
.run/
apps/**/node_modules/
apps/**/dist/
apps/**/.run/
apps/**/src-tauri/target/
apps/**/src-tauri/gen/
apps/**/src-tauri/binaries/*.exe
apps/**/src-tauri/binaries/*/
apps/**/src-tauri/binaries/*/_internal/
.superpowers/
.tmp-ui-split-backup/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Common generated outputs
out/
output/
outputs/
artifacts/
reports/
tmp/
temp/
*.tmp
*.log

# Generated workbook exports
*.xlsx
*.xlsm
~$*
