{
  "name": "minos-core-desktop-tauri",
  "version": "3.8.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:nsis": "npm run tauri:nsis:unsigned",
