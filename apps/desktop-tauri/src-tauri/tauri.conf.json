{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MINOS-CORE",
  "version": "1.14.0",
  "identifier": "com.minos.core.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MINOS-CORE Workbench",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": []
  }
}
