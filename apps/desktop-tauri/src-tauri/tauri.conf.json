{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MINOS-CORE",
  "version": "3.8.6",
  "identifier": "com.minos.core.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MINOS-CORE Workbench",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": ["binaries/minos-desktop-api"],
    "resources": {
      "binaries/minos-desktop-api-x86_64-pc-windows-msvc/_internal": "_internal"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    }
  }
}
