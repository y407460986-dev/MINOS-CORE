{
  "schema_version": "minos-core.process_inference.v1",
  "family_key": "door_hinge",
  "family_name": "门铰链",
  "description": "汽车车门铰链——连接车门与车身的机械轴承部件，允许车门绕固定轴线旋转。按制造方式分为锻造铰链、冲压铰链、热轧型钢铰链；按可视性分为外露铰链和隐藏铰链；按结构分为C型、鹅颈、贯通钢琴、剪刀门等。核心部件：铰链页板(leaf)、铰链销轴(pin)、铰链筒(knuckle)、衬套(bushing)。典型材料：SAPH310/370/440、SPCC、DC01-04、Q345、45钢、黄铜，料厚1-4mm。",
  "drawing_recognition_clues": {
    "typical_shapes": ["L形/倒T形弯曲件", "页板+销轴孔", "C形断面", "铰链筒(卷圆圆筒)", "安装法兰面", "加强筋", "焊接螺母/压铆螺母"],
    "typical_materials": ["SAPH310", "SAPH370", "SAPH440", "SPCC", "DC01", "DC04", "Q345", "B250P1", "45钢", "SUS304", "黄铜"],
    "typical_thickness": "1.0-4.0mm（冲压型）, 丸钢棒Φ12-25mm（锻造型）",
    "typical_features": ["铰链销轴孔(∮6-12mm,要求同轴)", "安装孔(∮8-13mm)", "卷圆/curl", "弯曲(90°/60°)", "翻孔/翻边", "镦粗增厚(螺纹区域)", "焊接方螺母", "压铆螺母", "衬套压入", "包边/hemming"],
    "surface_requirements": ["无毛刺(喷涂件≤0.05mm)", "无开裂", "无起皱", "回弹控制在±0.5°以内", "销轴孔同轴度≤0.1mm"],
    "tolerance_level": "IT12-IT14 (冲压), IT9-IT11 (精冲/铰链销轴孔)",
    "typical_standards": ["GB 15086-2013 (纵载≥11000N/横载≥9000N)", "GTR No.1", "IATF 16949"]
  },
  "hinge_types": {
    "forged_type": {
      "description": "锻造铰链——丸钢棒热锻成形(950-1350°C),强度可达GB标准3倍以上,德系车主流",
      "process_sequence": [
        { "seq": 10, "operation": "来料检验", "equipment": "光谱仪/硬度计", "key_check": "丸钢棒材质、化学成分、直径" },
        { "seq": 20, "operation": "加热", "equipment": "中频感应加热炉", "key_check": "加热温度950-1350°C" },
        { "seq": 30, "operation": "热锻成形", "equipment": "热模锻压力机/电液锤", "key_check": "充填完整、无折叠、无裂纹" },
        { "seq": 40, "operation": "切边", "equipment": "切边压力机", "key_check": "飞边切除干净" },
        { "seq": 50, "operation": "轴孔冲制", "equipment": "冲孔压力机+锥形冲头(70-120°)", "key_check": "轴孔径、圆度、轴孔高≥孔径×2.0" },
        { "seq": 60, "operation": "轴孔精整", "equipment": "压力机+精整冲头", "key_check": "孔径公差、内壁光洁度" },
        { "seq": 70, "operation": "热处理", "equipment": "调质/正火炉", "key_check": "硬度、金相组织" },
        { "seq": 80, "operation": "抛丸/清洗", "equipment": "抛丸机/清洗线", "key_check": "表面清洁度、粗糙度" },
