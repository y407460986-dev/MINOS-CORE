        { "seq": 120, "operation": "完工检验", "equipment": "CMM/检具/扭矩测试台", "key_check": "全尺寸、铰链刚度、开闭力矩" },
        { "seq": 130, "operation": "包装入库", "equipment": "包装台/打码机", "key_check": "数量、标识、防锈" }
      ]
    },
    "stamped_type": {
      "description": "冲压铰链——钢板冷冲压级进模成形,成本低,日系/经济型车主流,强度可达GB标准2倍以上",
      "process_sequence": [
        { "seq": 10, "operation": "来料检验", "equipment": "检具/量具/光谱仪", "key_check": "材质(SAPH310等)、料厚(1-4mm)、卷料宽度" },
        { "seq": 20, "operation": "开卷校平", "equipment": "开卷校平机", "key_check": "板形、表面清洁、送料顺畅" },
        { "seq": 30, "operation": "级进模冲压(含多工位)", "equipment": "精密压力机(160-630T)+级进模(4-12工位)", "key_check": "工位1-2:导正孔/冲孔、工位3-4:切边/切槽、工位5-8:弯曲(90°/60°渐进)、工位9-10:卷圆(curling,铰链筒成形)、工位11:镦粗(螺纹区域)、工位12:切断" },
        { "seq": 40, "operation": "去毛刺/清洗", "equipment": "振动光饰/超声波清洗", "key_check": "毛刺≤0.05mm、清洁度" },
        { "seq": 50, "operation": "焊接螺母/压铆螺母", "equipment": "点焊机/压铆机", "key_check": "焊接电流50-110A、电压17-24V、扭矩测试" },
        { "seq": 60, "operation": "压装衬套/销轴", "equipment": "压装机/铆接机", "key_check": "压入行程、压入力、销轴转动灵活" },
        { "seq": 70, "operation": "表面处理", "equipment": "电泳/达克罗/电镀线", "key_check": "膜厚、附着力、盐雾≥114h" },
        { "seq": 80, "operation": "完工检验", "equipment": "CMM/检具/扭矩测试台", "key_check": "铰链刚度、纵向≥11000N、横向≥9000N、转动扭矩、外观" },
        { "seq": 90, "operation": "包装入库", "equipment": "包装台/打码机", "key_check": "数量、标识、防锈" }
      ]
    }
  },
  "feature_to_operation": {
    "hinge_leaf": { "operation": "落料+弯曲", "equipment": "压力机+级进模", "note": "L形/倒T形弯曲,外→内顺序,回弹补偿0.05-0.1mm" },
    "curl_knuckle": { "operation": "卷圆(Curling)", "equipment": "压力机+卷圆模", "note": "铰链筒成形,Wikipedia: Door hinges are a common example of curling die" },
    "hinge_pin_hole": { "operation": "冲孔/铰孔", "equipment": "压力机+冲孔模(同轴要求)", "note": "∮6-12mm,同轴度≤0.1mm,同一工位一次冲出" },
    "mount_hole": { "operation": "冲孔", "equipment": "压力机", "note": "∮8-13mm安装孔,孔边距>2t" },
