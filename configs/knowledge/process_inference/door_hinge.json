    "bush_press": { "operation": "衬套压入", "equipment": "压装机", "note": "衬套压入+铰孔定径,保证转动间隙" },
    "pin_rivet": { "operation": "铰链销铆接", "equipment": "铆接机", "note": "销轴铆接,头部成形,转动灵活不松动" },
    "surface_treat": { "operation": "电泳/达克罗/电镀", "equipment": "涂装线/电镀线", "note": "耐盐雾≥114h,膜厚按图纸要求" },
    "cold_head_bulge": { "operation": "冷镦", "equipment": "压力机+冷镦模", "note": "钢板宽度方向端部冷镦成形圆柱状膨出部,材料向宽度方向挤出,非落料/冲裁" }
