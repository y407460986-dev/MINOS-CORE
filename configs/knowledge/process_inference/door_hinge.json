    "bend_hinge": { "operation": "多道弯曲", "equipment": "压力机+弯曲模/级进模", "note": "90°→60°渐进,弯曲线与纤维方向垂直或30-60°" },
    "weld_nut": { "operation": "点焊螺母", "equipment": "点焊机", "note": "M8焊接方螺母,电流50-110A,电压17-24V" },
