{
  "schema_version": "minos-core.process_inference.v1",
  "family_key": "limiter",
  "family_name": "限位器",
  "description": "汽车车门限位器（Door Check）——限制车门最大开度并在中间档位保持车门开启的装置。按限位臂型式分为冲压限位器、包塑限位器、全塑限位器；按弹性元件分为橡胶弹簧式、螺旋弹簧式、扭杆弹簧式；按结构分为滑移式和辊轴式。核心部件：限位臂(主臂)、限位盒(壳体总成)、安装支架、弹性元件(弹簧/橡胶块)、滚针/滑块、缓冲块。典型材料：Q345/45钢/SPCC(金属件)、POM/PA66/TPE/TPU(塑料件)。",
  "drawing_recognition_clues": {
    "typical_shapes": ["长条形限位臂(带凹凸档位槽)", "L形/Z形弯曲臂", "矩形盒状壳体", "U形安装支架", "圆孔(安装孔/销轴孔)", "档位槽(凹坑/凸台)"],
    "typical_materials_metal": ["Q345", "45钢", "SPCC", "SAPH310", "SAPH370"],
    "typical_materials_plastic": ["POM(聚甲醛,滑动件)", "PA66+GF(尼龙+玻纤,结构件)", "TPE(热塑性弹性体,缓冲)", "TPU(热塑性聚氨酯,阻尼)", "NR(天然橡胶,耐低温-70°C)", "NBR(丁腈橡胶,耐油)"],
    "typical_thickness": "金属臂2.0-5.0mm, 塑料壳体1.5-3.0mm",
    "typical_features": ["档位凹槽/凸台(2-3档)", "安装孔(∮8-13mm)", "铰接孔(∮6-12mm)", "限位面(弧形轮廓)", "包胶/包塑层", "加强筋", "卡扣/搭扣", "焊接螺母"],
    "surface_requirements": ["无毛刺(防止磨损滑块)", "无飞边(塑料件)", "档位槽表面光洁度Ra≤0.8μm", "包塑附着力强无剥离", "盐雾≥114h(金属件)"],
    "tolerance_level": "IT12-IT13 (冲压件), IT9-IT11 (档位槽精压), 塑料件按GB/T 14486"
  },
  "limiter_types": {
    "stamped_limiter": {
      "description": "冲压限位器——限位臂以冲压工艺实现档位结构,金属臂+金属壳体,成本最低",
      "process_sequence": [
        { "seq": 10, "operation": "来料检验", "equipment": "检具/量具/光谱仪", "key_check": "材质(Q345/SPCC)、料厚(2-5mm)" },
        { "seq": 20, "operation": "开卷校平/下料", "equipment": "开卷机/剪板机", "key_check": "板形、下料尺寸" },
        { "seq": 30, "operation": "级进模冲压(含档位槽精压)", "equipment": "精密压力机(160-400T)+级进模(8-15工位)", "key_check": "工位1-2:导正孔/冲孔、工位3-4:切边/切口、工位5-6:预弯、工位7-8:终弯翻边、工位9-10:档位槽精压(coining,≤30%料厚,氮气弹簧保证)、工位11-12:冲安装孔、末工位:切断" },
        { "seq": 40, "operation": "去毛刺/清洗", "equipment": "振动光饰/超声波清洗", "key_check": "毛刺可控,档位槽无毛刺(防止磨损滑块)" },
        { "seq": 50, "operation": "电镀(三价铬)", "equipment": "电镀线", "key_check": "膜厚、附着力、盐雾≥114h、去氢处理" },
        { "seq": 60, "operation": "限位臂包胶(如适用)", "equipment": "注塑机(嵌件成形)", "key_check": "包胶厚度均匀、无气泡、附着力" },
        { "seq": 70, "operation": "限位盒组装", "equipment": "组装台/自动装配线", "key_check": "壳体铆接、弹簧/滑块/滚针装入、注润滑脂" },
        { "seq": 80, "operation": "扭矩检测", "equipment": "扭矩测试台", "key_check": "开门力30-35N,最大扭矩390N·m不破坏,档位保持力" },
        { "seq": 90, "operation": "完工检验", "equipment": "检具/CMM/耐久试验台", "key_check": "5万次耐久、-32°C耐寒、+80°C耐热、盐雾114h" },
        { "seq": 100, "operation": "包装入库", "equipment": "包装台/打码机", "key_check": "数量、标识、防锈" }
      ]
    },
    "overmolded_limiter": {
      "description": "包塑限位器——金属骨架+注塑包覆+限位盒(金属或塑料),平衡强度与噪音,当前主流",
      "process_sequence": [
        { "seq": 10, "operation": "来料检验(金属骨架)", "equipment": "检具/量具", "key_check": "冲压骨架尺寸、材质" },
        { "seq": 20, "operation": "来料检验(塑料粒子)", "equipment": "水分仪/熔指仪", "key_check": "POM/PA66/TPE粒子干燥、熔融指数" },
        { "seq": 30, "operation": "金属骨架冲压", "equipment": "压力机+级进模", "key_check": "骨架外形、预冲孔、去毛刺" },
        { "seq": 40, "operation": "金属骨架表面处理", "equipment": "磷化/电泳线", "key_check": "增加树脂结合力" },
        { "seq": 50, "operation": "1次射出成形(结构层)", "equipment": "注塑机(嵌件成形)", "key_check": "PA66+GF包覆金属芯,提供结构强度" },
        { "seq": 60, "operation": "2次射出成形(滑动层)", "equipment": "二色注塑机/旋转模", "key_check": "POM包覆表面层(滑动+耐磨+低噪音),化学结合力" },
        { "seq": 70, "operation": "去飞边/检验", "equipment": "修边工位/视觉检测", "key_check": "无飞边、无缩痕、无气泡、包胶附着力" },
        { "seq": 80, "operation": "限位盒组装(塑料壳体)", "equipment": "自动装配线(铆接/卡扣/熔接)", "key_check": "壳体闭合、弹簧/滚针装入、注润滑脂(NR兼容)" },
        { "seq": 90, "operation": "扭矩检测+耐久验证", "equipment": "扭矩测试台+耐久试验台", "key_check": "操作为矩30-35N,档位感清晰,5万次后扭矩变化≤30%" },
        { "seq": 100, "operation": "完工检验", "equipment": "CMM/环境试验箱", "key_check": "-32°C~+80°C温度循环、盐雾114h、NVH无异响" },
        { "seq": 110, "operation": "包装入库", "equipment": "包装台", "key_check": "数量、标识" }
      ]
    },
    "full_plastic_limiter": {
      "description": "全塑限位器——无金属紧固件,全树脂结构,轻量化,消除金属摩擦异响,新兴趋势",
      "process_sequence": [
        { "seq": 10, "operation": "来料检验(塑料粒子)", "equipment": "水分仪/熔指仪", "key_check": "POM/PA66+GF/TPE粒子干燥" },
        { "seq": 20, "operation": "限位臂注塑成形", "equipment": "注塑机+热流道模", "key_check": "尺寸、档位槽精度、无缩痕" },
        { "seq": 30, "operation": "壳体注塑成形", "equipment": "注塑机", "key_check": "壳体+罩盖分体注塑" },
        { "seq": 40, "operation": "弹性元件/滑块注塑", "equipment": "注塑机", "key_check": "TPE/TPU缓冲块、POM滑块" },
        { "seq": 50, "operation": "壳体熔接组装", "equipment": "超声波/热板焊接机", "key_check": "壳体闭合强度、无泄漏、熔接质量" },
        { "seq": 60, "operation": "滑块/弹簧装入", "equipment": "自动装配", "key_check": "滑动顺畅、注润滑脂" },
        { "seq": 70, "operation": "扭矩检测", "equipment": "扭矩测试台", "key_check": "30-35N操作力、档位保持力" },
        { "seq": 80, "operation": "完工检验", "equipment": "检具/环境试验箱", "key_check": "5万次耐久、温度循环、NVH" },
        { "seq": 90, "operation": "包装入库", "equipment": "包装台", "key_check": "数量、标识" }
      ]
    }
  },
  "feature_to_operation": {
    "detent_notch": { "operation": "档位槽精压(Coining)", "equipment": "压力机+精压模(氮气弹簧)", "note": "限位器核心特征,深度≤30%料厚,两面可不同特征,影响档位手感" },
    "check_arm_contour": { "operation": "切口+弯曲", "equipment": "级进模", "note": "长条形臂外形,切口非封闭轮廓→弯曲成形" },
    "check_arm_bend": { "operation": "L形/Z形弯曲", "equipment": "压力机+弯曲模", "note": "弯曲线垂直轧制方向,弯曲半径≥1.5t,防止各向异性开裂" },
    "mount_hole": { "operation": "冲孔", "equipment": "压力机", "note": "安装孔∮8-13mm" },
    "hinge_hole": { "operation": "冲孔+铰孔", "equipment": "压力机+铰孔机", "note": "限位臂铰接孔∮6-12mm" },
    "metal_insert_blanking": { "operation": "落料冲孔", "equipment": "压力机+落料模", "note": "包塑限位器金属骨架冲压" },
    "plastic_overmold_1st": { "operation": "1次射出(结构层)", "equipment": "注塑机+嵌件模", "note": "PA66+GF包覆金属芯,提供结构强度" },
    "plastic_overmold_2nd": { "operation": "2次射出(滑动层)", "equipment": "二色注塑机/旋转模", "note": "POM包覆表面,提供滑动性+耐磨+低噪音" },
    "buffer_rubber": { "operation": "注塑/硫化", "equipment": "注塑机/硫化机", "note": "TPE/TPU/NR/NBR缓冲块成形" },
    "housing_rivet": { "operation": "壳体铆接/熔接", "equipment": "铆接机/超声波焊接机", "note": "金属盒铆接或塑料盒熔接" },
    "grease_fill": { "operation": "注润滑脂", "equipment": "注脂机", "note": "限位盒内填充低温润滑脂(耐-40°C)" },
    "torque_test": { "operation": "扭矩检测", "equipment": "扭矩测试台", "note": "操作力30-35N,最大扭矩≥390N·m,档位力曲线" },
    "durability_test": { "operation": "耐久试验", "equipment": "耐久试验台", "note": "5万次循环,扭矩变化≤30%,无异响" }
  },
