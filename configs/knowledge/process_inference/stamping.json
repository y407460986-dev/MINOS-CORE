    "typical_thickness": "0.5-6mm",
    "typical_features": ["冲孔", "翻边", "翻孔", "压筋", "切口", "百叶窗", "沉孔", "凸包", "压印"],
    "surface_requirements": ["无毛刺", "无划伤", "无开裂", "无起皱", "无压印"],
    "tolerance_level": "IT12-IT14 (普通冲压), IT9-IT11 (精冲)"
  },
